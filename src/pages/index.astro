---
import Base from '../layouts/Base.astro';
import Fill from '../components/Fill.astro';
import Plaque from '../components/Plaque.astro';
import { about } from '../data/about';
---
<Base home>
  <div class="home">
    <header class="hull">
     <div class="hull__inner">
      <div>
        <h1>{about.name}</h1>
        <p class="hull__role">{about.tagline}</p>
      </div>
      <a class="hull__jump" href="/projects">See my projects</a>
      <nav class="hull__links" aria-label="Contact">
        {about.links.map((link) => <Plaque {...link} />)}
      </nav>
     </div>
    </header>
    <div class="water">
      <div class="sections">
        <section class="about section" id="about" aria-labelledby="about-h">
          <h2 id="about-h">About me</h2>
          <div class="about__grid">
            <div class="about__main">
              <p class="about__lead">{about.lead.start}<mark>{about.lead.mark}</mark>{about.lead.end}</p>
              <dl class="facts">
                {about.facts.map((fact, n) => (
                  <div class="reveal" style={`--n:${n}`}><dt>{fact.label}</dt><dd><Fill text={fact.value} /></dd></div>
                ))}
              </dl>
            </div>
            <figure class="portrait">
              <img src="/fionn.webp" srcset="/fionn-sm.webp 450w, /fionn.webp 900w" sizes="(max-width: 820px) 60vw, 16rem" width="900" height="1125" alt="Fionn Mowlds in a Rowing Ireland top, holding an Irish flag beside a rowing lake" decoding="async" fetchpriority="high" />
            </figure>
          </div>
        </section>
        <section class="section" id="experience" aria-labelledby="experience-h">
          <h2 id="experience-h">Experience</h2>
          <ol class="jobs">
            {about.experience.map((job, n) => (
              <li class="reveal" style={`--n:${n}`}>
                <p class="jobs__when">{job.when}</p>
                <div>
                  <h3>{job.role}</h3>
                  <p class="jobs__org">{job.org}</p>
                  <p>{job.note}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
        <section class="section" id="skills" aria-labelledby="skills-h">
          <h2 id="skills-h">Skills</h2>
          <dl class="skills">
            {about.skills.map((skill, n) => (
              <div class="reveal" style={`--n:${n}`}><dt>{skill.group}</dt><dd>{skill.items}</dd></div>
            ))}
          </dl>
        </section>
      </div>
      <a class="oar" href="/projects">
        <span class="oar__label">Projects <span class="oar__arrow" aria-hidden="true">→</span></span>
        <span class="oar__line">
          <span class="oar__shaft" aria-hidden="true"><i class="oar__grip"></i><i class="oar__sleeve"></i></span>
          <span class="oar__stage">
            <svg class="oar__blade" viewBox="0 0 260 110" aria-hidden="true">
              <defs>
                <clipPath id="blade-shape">
                  <path d="M0 50 34 44C80 33 140 9 232 8c16 0 24 6 24 18v58c0 12-8 18-24 18C140 101 80 77 34 66L0 60Z" />
                </clipPath>
                <linearGradient id="blade-sheen" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#fff" stop-opacity=".28" />
                  <stop offset=".5" stop-color="#fff" stop-opacity="0" />
                  <stop offset="1" stop-color="#000" stop-opacity=".22" />
                </linearGradient>
              </defs>
              <g clip-path="url(#blade-shape)">
                <rect class="paint-navy" width="260" height="110" />
                <rect class="paint-white" x="128" width="48" height="110" />
                <rect class="paint-sky" x="176" width="48" height="110" />
                <rect width="260" height="110" fill="url(#blade-sheen)" />
                <path class="blade-rib" d="M6 55H250" />
              </g>
              <path class="blade-edge" d="M0 50 34 44C80 33 140 9 232 8c16 0 24 6 24 18v58c0 12-8 18-24 18C140 101 80 77 34 66L0 60Z" />
            </svg>
            <span class="oar__ripple" aria-hidden="true"></span>
          </span>
        </span>
        <span class="oar__depth" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</Base>
